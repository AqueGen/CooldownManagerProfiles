package-as: CooldownManagerProfiles

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  # AGENTS.md is deliberately NOT ignored: the notice only does its job where
  # an agent actually reads the addon, which is the installed folder.
  - README.md
  - RELEASE_NOTES.md
  - release-please-config.json
  - .release-please-manifest.json
  - CURSEFORGE.md
  - .claude
  - .gitignore
